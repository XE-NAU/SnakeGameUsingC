{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run raylib (snake)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/raylib/w64devkit/bin;${env:PATH}"
                }
            ],
            "console": "externalTerminal",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/raylib/w64devkit/bin/gdb.exe",
            "preLaunchTask": "build raylib (snake)"
        }
    ]
}
